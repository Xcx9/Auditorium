@startuml SmartCampus_UseCase
left to right direction
skinparam packageStyle rectangle

actor "Пользователь" as User

rectangle "SmartCampus" {
  usecase "Авторизоваться" as UC0
  usecase "Найти свободную аудиторию сейчас" as UC1
  usecase "Посмотреть карточку аудитории" as UC2
  usecase "Отметить аудиторию занятой" as UC3
  usecase "Снять свою отметку" as UC4
  usecase "Просмотреть свою активную отметку" as UC5
}

User --> UC0
User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5

UC1 ..> UC0 : <<include>>
UC2 ..> UC0 : <<include>>
UC3 ..> UC0 : <<include>>
UC4 ..> UC0 : <<include>>
UC5 ..> UC0 : <<include>>

note right of UC3
  Отметка создаётся в текущий
  момент. Времени окончания нет.
  У пользователя может быть
  только одна активная отметка.
  У аудитории — тоже только одна.
end note

note bottom of UC1
  Парсер расписания работает
  автоматически при запуске
  и не реже раза в 60 минут.
  Ручного запуска нет.
end note
@enduml