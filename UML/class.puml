@startuml SmartCampus_Class
skinparam classAttributeIconSize 0

class User {
  - int Id
  - string Login
  - string PasswordHash
  + string GetDisplayName()
}

class Room {
  - int Id
  - string Number
  - bool IsEnabled
  + string FullName()
  + int BuildingNumber()
  + int FloorNumber()
  + {static} bool IsValidNumber(string number)
}

class ScheduleEntry {
  - int Id
  - int RoomId
  - DateTime Start
  - DateTime End
  + bool IsActiveAt(DateTime moment)
  + DateTime? NextStartAfter(DateTime moment)
}

class OccupancyMark {
  - int Id
  - int RoomId
  - int UserId
  - DateTime CreatedAt
  - bool IsCancelled
  + bool IsActive()
  + void Cancel()
}

class RoomStatusService {
  + RoomState GetStatus(Room room, DateTime now)
  + List<RoomStatus> GetFreeRooms(DateTime now)
  + MarkResult CreateMark(Room room, User user)
  + MarkResult CancelMark(OccupancyMark mark, User user)
  + OccupancyMark? GetActiveMarkOf(User user)
  + void AutoReleaseMarksAtClassStart(DateTime now)
}

class RoomStatus {
  + Room Room
  + RoomState State
}

enum RoomState {
  Free
  Busy
}

class ScheduleParser {
  + Task<ScheduleParseResult> UpdateAsync()
  + DateTime LastSuccessfulUpdate
  + bool IsStale()
}

User "1" -- "0..1" OccupancyMark : создаёт
Room "1" -- "0..1" OccupancyMark : имеет
Room "1" -- "0..*" ScheduleEntry : имеет
RoomStatusService ..> Room : использует
RoomStatusService ..> OccupancyMark : управляет
RoomStatusService ..> ScheduleEntry : читает
RoomStatusService --> RoomStatus
RoomStatus --> RoomState
ScheduleParser ..> ScheduleEntry : формирует

note right of Room
  Формат номера: ABCD[буква]
  A — корпус (1, 3 или 4)
  B — этаж (0–4)
  CD — номер на этаже
  Пример: 3120 — корпус 3,
  этаж 1, аудитория 20.
end note

note right of OccupancyMark
  Без времени окончания.
  Снимается пользователем
  или автоматически при начале
  следующей пары. Если пары
  нет — до ручного снятия.
end note

note bottom of RoomStatusService
  Правила создания отметки:
  - одна активная на пользователя
  - одна активная на аудиторию
  - снятие чужой запрещено
  - приоритет у расписания
end note

note bottom of ScheduleParser
  Обновление автоматическое:
  при запуске и раз в 60 минут.
  При недоступности — работа
  с последней копией и показ
  времени последнего обновления.
end note
@enduml