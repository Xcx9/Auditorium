@startuml SmartCampus_Activity_Find
start
:Открыть экран «Свободные сейчас»;
:Получить текущее время с сервера;
:Загрузить список аудиторий;
:Загрузить расписание из локальной копии;
if (Локальная копия устарела?) then (да)
  :Показать предупреждение
  о времени последнего обновления;
endif
:Для каждой аудитории вычислить статус;
if (Идёт занятие по расписанию?) then (да)
  :Статус = «занято»;
elseif (Есть активная отметка?) then (да)
  :Статус = «занято»;
else
  :Статус = «свободно»;
endif
:Показать список свободных;

if (Пользователь хочет отметить аудиторию?) then (да)
  if (У пользователя есть активная отметка?) then (да)
    :Отказать: «У вас уже есть активная отметка»;
  elseif (У аудитории есть активная отметка?) then (да)
    :Отказать: «Аудитория уже отмечена»;
  elseif (Идёт занятие по расписанию?) then (да)
    :Отказать: «Идёт занятие»;
  else
    :Создать отметку;
    :Сообщить об успехе;
  endif
endif

stop
@enduml