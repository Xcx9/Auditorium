@startuml SmartCampus_Sequence_Conflict
actor U1 as "Пользователь 1"
actor U2 as "Пользователь 2"
participant "Веб-интерфейс" as UI
participant "RoomStatusService" as S
participant "БД" as DB

U1 -> UI : Отметить ауд. 3120 занятой
UI -> S : CreateMark(3120, U1)
S -> DB : INSERT mark(U1, 3120)
DB --> S : OK
S --> UI : Success
UI --> U1 : «Отмечено»

U2 -> UI : Отметить ауд. 3120 занятой
UI -> S : CreateMark(3120, U2)
S -> DB : Проверить активную отметку аудитории
DB --> S : Есть активная отметка (U1)
S --> UI : MarkResult.AlreadyBusyByRoom
UI --> U2 : «Аудитория уже отмечена»

note over S
  Одна аудитория —
  не более одной активной отметки.
end note
@enduml